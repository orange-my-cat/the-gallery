# The Gallery - environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored and does NOT travel with the
# repository; it is copied by hand when moving machines.
#
# Two profiles are documented below. The two numbers that must never be
# confused are stated in full:
#
#     DEVELOPMENT   Django on port 8001, database on localhost:5433
#     PRODUCTION    Gunicorn on container port 8000, database at data-center:5432
#
# Port 8000 on the host is published by `control-tower` (Portainer) and is
# unavailable to this project. Development binds 8001.
#
# ---------------------------------------------------------------------------
# THE SHARPEST EDGE IN THIS TOPOLOGY. READ BEFORE EDITING THE DB BLOCK.
# ---------------------------------------------------------------------------
# `data-center` (production) publishes 0.0.0.0:5432 on this host.
# `data-center-test` (development) publishes 0.0.0.0:5433. Both hold a database
# called `gallery`, so the PORT is the only thing telling them apart:
#
#     POSTGRES_PORT=5433  ->  gallery on data-center-test  - development data
#     POSTGRES_PORT=5432  ->  gallery on data-center       - the real catalogue
#
# `config.settings.dev` refuses to start on port 5432 or host `data-center`.
# That guard is the tripwire; it is not a licence to be careless here.

# ===========================================================================
# DEVELOPMENT PROFILE  -  local hot-reloading process on Windows
# ===========================================================================

DJANGO_SETTINGS_MODULE=config.settings.dev

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

DJANGO_DEBUG=true

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8001,http://host.docker.internal:5174

# Django admin is a break-glass tool, not an alternative interface. It lives at
# a non-obvious path. Change this value; do not ship the example.
DJANGO_ADMIN_PATH=ops-gallery

DJANGO_TIME_ZONE=Asia/Kuala_Lumpur

# The single account. The sign-in screen asks only for its password; set or
# reset that with `python manage.py reset_password`.
GALLERY_USERNAME=owner

# --- Database: data-center-test, the DEVELOPMENT instance -------------------
POSTGRES_DB=gallery
POSTGRES_USER=gallery
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# The Django development server. 8001, not 8000 - see the note above.
DJANGO_DEV_PORT=8001

# The Vite dev server proxies /api and /media to the Django port so the browser
# sees one origin, with no CORS layer.
VITE_DEV_PORT=5173

# --- Library, cache, media delivery -----------------------------------------
# A SAMPLE COPY of the library, never the real one. Development bugs must only
# be able to damage disposable files, and two instances must never write to the
# same library.
LIBRARY_ROOT=D:/Photos-dev
# Thumbnails and previews. Unset means `.cache/` in the repository (git-ignored).
CACHE_ROOT=
# `django` streams media through FileResponse (no Range support, so video
# seeking may not work in development - accepted). `accel` is production's
# X-Accel-Redirect to Nginx.
MEDIA_DELIVERY=django

# The worker's media tools. Leave empty if exiftool / ffmpeg / ffprobe are on
# PATH; otherwise give the full path to each .exe. (In the image they are
# Debian packages on PATH, so production never sets these.)
EXIFTOOL_PATH=
FFMPEG_PATH=
FFPROBE_PATH=

# Development takes no dumps. The smoke test reports "no backups configured".
BACKUP_DIR=

# ===========================================================================
# PRODUCTION PROFILE  -  the `gallery` container on the vibe-city network
# ===========================================================================
# Production reads its own file, .env.production (git-ignored), so this .env
# can stay on the development profile while production runs. Copy this whole
# template to .env.production, delete the development block, and uncomment
# this one. scripts/deploy.ps1 refuses a .env.production that is not it.
#
# DJANGO_SETTINGS_MODULE=config.settings.prod
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=gallery.localhost
# DJANGO_CSRF_TRUSTED_ORIGINS=http://gallery.localhost
#
# --- Database: data-center, the PRODUCTION instance -------------------------
# Reached by Docker DNS over the `vibe-city` network. The hostname
# `data-center` does not resolve from the Windows host at all.
#
# POSTGRES_DB=gallery
# POSTGRES_USER=gallery
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=data-center
# POSTGRES_PORT=5432
#
# --- Library, cache, media delivery -----------------------------------------
# Whole drives are mounted, one folder per letter under /library (D:\ is
# /library/D), and the library folder is chosen on the settings screen.
# Read-write (Phase 1b writes edits, trash and moves). central-station mounts the same drives read-only
# to stream the bytes - keep vibe-city/start.ps1 in step with this list. The
# cache is the `gallery-cache` named volume at /cache.
#
# LIBRARY_DRIVES=D
# LIBRARY_ROOT=/library
# CACHE_ROOT=/cache
# MEDIA_DELIVERY=accel
#
# --- Backups ----------------------------------------------------------------
# The Windows folder the container writes database dumps into, bind-mounted at
# /backups. Not optional: the instance is shared with other tenants.
#
# BACKUP_HOST_DIR=D:/Backups/Gallery
# BACKUP_DIR=/backups
# BACKUP_RETAIN=30
# BACKUP_MAX_AGE_HOURS=24
#
# --- Worker -----------------------------------------------------------------
# Worker processes inside the container. Each keeps an ExifTool running and a
# database connection open. Raise it for a faster first scan of a large library.
#
# WORKER_PROCESSES=4
#
# --- Gunicorn ---------------------------------------------------------------
# GUNICORN_WORKERS=2
# GUNICORN_BIND=0.0.0.0:8000
